---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Max Taylor";

import BlogSection from "../components/BlogSection.astro";
import CaseStudySection from "../components/CaseStudySection.astro";
---

<BaseLayout pageTitle={pageTitle}>
    <section>
        <div class="wrapper-wide">
            <h1>Max Taylor</h1>
            <p class="subhead">Product Designer and Frontend Developer</p>
            <p class="intro">
                With more than a decade of experience in product design and
                coding skills to boot, I excel at systems thinking, rapid
                prototyping, and solving complex problems. I believe that iterative
                improvement and cross-team collaboration are key to developing
                user-centric products.
            </p>
        </div>
    </section>

    <section>
        <div class="wrapper-wide">
            <h2 class="section-header">Selected Work</h2>
            <CaseStudySection />
        </div>
    </section>

    <section>
        <div class="wrapper-wide">
            <h2 class="section-header">Latest Posts</h2>
            <BlogSection />
        </div>
    </section>
</BaseLayout>

<style>
    .subhead {
        font-size: var(--text-2xl);
        line-height: var(--text-2xl-line-height);
        font-weight: var(--font-weight-normal);
        color: var(--text-soft);
        margin-block-end: var(--size-5);
    }

    .intro {
        font-size: var(--text-xl);
        line-height: var(--text-xl-line-height);
        margin-block-end: var(--size-1);
        text-wrap: balance;
        max-width: 65ch;
    }

    .section-header {
        margin-block-end: var(--size-4);
    }

    section {
        margin-block: var(--size-13);
    }
</style>
