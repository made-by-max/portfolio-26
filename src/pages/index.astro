---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Max Taylor";

import BlogSection from "../components/BlogSection.astro";
import CaseStudySection from "../components/CaseStudySection.astro";
import PlaygroundFeaturedSection from "../components/PlaygroundFeaturedSection.astro";
import LinkToMore from "../components/LinkToMore.astro";
---

<BaseLayout pageTitle={pageTitle}>
    <section>
        <div class="wrapper-wide">
            <h1>Max Taylor</h1>
            <p class="subhead">Product Designer and Developer</p>
            <p class="intro">
                With more than a decade of experience in product design and
                coding skills to boot, I excel at systems thinking, rapid
                prototyping, and solving complex problems. I believe that
                iterative improvement and cross-team collaboration are key to
                developing user-centric products.
            </p>
        </div>
    </section>

    <section>
        <div class="wrapper-wide">
            <h2>Selected Work</h2>
            <div class="section-header">
                <p>Product design case studies</p>
                <LinkToMore url="/work" text="All case studies" />
            </div>
            <CaseStudySection />
        </div>
    </section>

    <section>
        <div class="wrapper-wide">
            <div class="section-intro">
                <h2>Playground</h2>
                <div class="section-header">
                    <p>Prototypes, experiments, and smaller coding projects</p>
                    <LinkToMore url="/playground" text="All playground" />
                </div>
            </div>

            <PlaygroundFeaturedSection />
        </div>
    </section>

    <section>
        <div class="wrapper-wide">
            <h2>Latest Posts</h2>
            <div class="section-header">
                <p>Various thoughts and musings</p>
                <LinkToMore url="/writing" text="All posts" />
            </div>
            <BlogSection />
        </div>
    </section>
</BaseLayout>

<style>
    h1 {
        margin-block-end: var(--size-2);
    }
    .subhead {
        font-size: var(--text-2xl);
        line-height: var(--text-2xl-line-height);
        font-weight: var(--font-weight-normal);
        color: var(--text-soft);
        margin-block-end: var(--size-5);
    }

    .intro {
        font-size: var(--text-xl);
        line-height: var(--text-xl-line-height);
        margin-block-end: var(--size-1);
        text-wrap: balance;
        max-width: 65ch;
    }

    .section-header {
        margin-block-end: var(--size-4);
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: baseline;
    }

    section {
        margin-block: 180px;
    }
</style>
