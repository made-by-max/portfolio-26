---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Max Taylor";

import BlogSection from "../components/BlogSection.astro";
import FeaturedCaseStudies from "../components/FeaturedCaseStudies.astro";
import PlaygroundFeaturedSection from "../components/PlaygroundFeaturedSection.astro";
import SectionHeader from "../components/SectionHeader.astro";
---

<BaseLayout pageTitle={pageTitle}>
    <section>
        <div class="wrapper-wide">
            <h1>Max Taylor</h1>
            <p class="eyebrow">
                Systems-focused product designer simplifying complex problems
                and exploring the space between design and code
            </p>
        </div>
    </section>

    <section>
        <div class="wrapper-wide">
            <SectionHeader
                sectionNumber="01"
                headerText="Selected Case Studies"
                linkText="All case studies"
                link="/design/"
            />
            <FeaturedCaseStudies />
        </div>
    </section>

    <section>
        <div class="wrapper-wide">
            <SectionHeader
                sectionNumber="02"
                headerText="Playground"
                linkText="All playground"
                link="/playground/"
            />
            <PlaygroundFeaturedSection />
        </div>
    </section>

    <section>
        <div class="wrapper-wide">
            <SectionHeader
                sectionNumber="03"
                headerText="Latest Writing"
                linkText="All posts"
                link="/writing/"
            />
            <BlogSection />
        </div>
    </section>
</BaseLayout>

<style>
    h1 {
        margin-block-end: var(--size-2);
    }

    .eyebrow {
        margin-block-end: var(--size-5);
    }
    .intro {
        font-size: var(--text-xl);
        line-height: var(--text-xl-line-height);
        margin-block-end: var(--size-1);
        text-wrap: balance;
        max-width: 65ch;
    }

    section {
        margin-block: 180px;
    }
</style>
