---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudySection from "../components/CaseStudySection.astro";
import LinkToMore from "../components/LinkToMore.astro";
import ProductDesignBlogSection from "../components/ProductDesignBlogSection.astro";
import "../styles/cards.css";
const posts = await getCollection("design");

const heading = "Selected Work";
const pageTitle = "Selected Work";
---

<BaseLayout pageTitle={pageTitle}>
    <section>
        <div class="wrapper-wide">
            <h1 class="section-header">Selected Work</h1>
            <p class="subhead">Product design case studies</p>
            <CaseStudySection />
        </div>
    </section>
    <section>
        <div class="wrapper-wide">

            <div class="section-header">
              <h2>Related Blog Posts</h2>

            </div>
            <ProductDesignBlogSection />
            <LinkToMore url="/writing" text="All posts" />
        </div>
    </section>
</BaseLayout>

<style>
    h1 {
        margin-block-end: var(--size-2);
    }
    .subhead {
        font-size: var(--text-2xl);
        line-height: var(--text-2xl-line-height);
        font-weight: var(--font-weight-normal);
        color: var(--text-soft);
        margin-block-end: var(--size-10);
    }

    .section-header {
        margin-block-end: var(--size-4);
        display: flex;
        flex-direction: column;
        /*justify-content: space-between;
        align-items: baseline;*/
    }
    section {
        margin-block: 180px;
    }
</style>
