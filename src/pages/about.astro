---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "About Max";
const heading = "About Max";
---

<BaseLayout pageTitle={pageTitle}>
    <div class="wrapper-wide sidebarLayout">
        <div class="main-content">
            <article>
                <h1>👋 Hey there, I'm Max!</h1>
                <p class="subhead">
                    I work hard so my dog can have a better life.
                </p>
                <p>
                    I've been a product designer for more than 10 years, working
                    in the fields of healthcare, developer experience, and
                    acadamia. I've also been dabbling in frontend code since the
                    early days of the web and have started adding some backend
                    over the past couple of years.
                </p>

                <p>
                    I specialize in information architecture, systems thinking,
                    accessibility and inclusive design.
                </p>

                <p>
                    I'm based in Portland, OR, and when I'm not working I enjoy
                    powerlifting, reading, hiking, and hanging out with my
                    faithful pup, Rufus.
                </p>
            </article>

            <aside>
                <img
                    class="profile"
                    src="../profilepic.jpg"
                    alt="A headshot of Max, a white person with short brown hair and glasses."
                />
            </aside>
        </div>
    </div>
</BaseLayout>

<style>
    .subhead {
        font-size: var(--text-2xl);
        line-height: var(--text-2xl-line-height);
        font-weight: var(--font-weight-medium);
        color: var(--text-secondary);
    }

    img.profile {
        max-width: 300px;
        border-radius: 100%;
        margin-block-start: 180px;
    }

    p {
        margin-block-end: var(--size-4);
    }
</style>
