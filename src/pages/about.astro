---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "About Max";
const heading = "About Max";
---

<BaseLayout pageTitle={pageTitle}>
    <div class="wrapper-wide sidebarLayout">
        <div class="main-content">
            <article>
                <h1>👋 Hey there, I'm Max!</h1>
                <p class="eyebrow">
                    I work hard so my dog can have a better life
                </p>
                <p>
                    I've been a product designer for more than 10 years, working
                    in the fields of healthcare, developer experience, and
                    acadamia. I've also been dabbling in frontend code since the
                    early days of the web and have started adding some backend
                    over the past couple of years.
                </p>

                <p>
                    I specialize in information architecture, systems thinking,
                    accessibility and inclusive design.
                </p>

                <p>
                    I'm based in Portland, OR, and when I'm not working I enjoy
                    powerlifting, reading, hiking, and hanging out with my
                    faithful pup, Rufus.
                </p>
            </article>

            <aside>
                <div class="img-wrap">
                    <div class="img-shadow-bg" aria-hidden="true"></div>
                    <div class="img-inner">
                        <img
                            src="../profilepic.JPG"
                            alt="A headshot of Max, a white person with short brown hair and glasses."
                        />
                    </div>
                </div>
            </aside>
        </div>
    </div>
</BaseLayout>

<style>
    /*img.profile {
        max-width: 300px;
        border-radius: 100%;
        margin-block-start: 180px;
    }*/
    h1 {
        margin-block-end: var(--size-2);
    }

    p {
        font-size: var(--text-xl);
        line-height: var(--text-xl-line-height);
        margin-block-end: var(--size-4);
        text-wrap: balance;
        max-width: 65ch;
    }

    .eyebrow {
        font-family: var(--font-accent);
        font-size: var(--text-s);
        text-transform: uppercase;
        /*font-weight: var(--font-weight-semibold);*/
        color: var(--text-soft);
    }

    .img-wrap {
        position: relative;
        /* Space at bottom and right for shadow card */
        margin-bottom: 16px;
        margin-right: 16px;
        margin-block: var(--size-10-fluid, 2.5rem);
        max-width: 300px;
    }

    /* Orange shadow card at BOTTOM-RIGHT */
    .img-shadow-bg {
        position: absolute;
        top: 16px;
        left: 16px;
        right: -16px;
        bottom: -16px;
        background-color: var(--brand-primary, #ff5c00);
        border: 2px solid var(--card-stroke, #111);
        border-radius: 10px;
        transform: rotate(0.73deg);
    }

    .img-inner {
        position: relative;
        background-color: var(--background-secondary, #f3f4f2);
        border: 2.5px solid var(--card-stroke, #111);
        border-radius: 11px;
        overflow: hidden;
        z-index: 1;
        /* Stretch to fill, with text content expanding */
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .img-inner img {
        max-width: 300px;
        height: auto;
        display: block;
    }
</style>
