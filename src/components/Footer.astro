
---

import SocialLinks from "../components/SocialLinks.astro";
---
<nav>
    <div>
        <p class="footer-cta">Like what you see? Get in touch!</p>
        <p class="email">madebymax.dev@gmail.com</p>
    </div>
    <div class="socialLinks">
        <SocialLinks />
    </div>

    <style>
        nav {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            a {
                text-decoration: none;
                color: inherit;
                font-size: var(--font-size-3);
                font-weight: var(--font-weight-5);
            }
            a:hover,
            a:focus {
                color: var(--brand-primary);
            }

    </style>

</nav>
