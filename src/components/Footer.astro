---
import "../styles/global.css";
import "../styles/nav.css";

const email = "hi@maxtaylor.design";
---

<footer>
    <div class="footer-inner wrapper-wide">
        <div class="footer-links">
            <nav class="footer-nav" aria-label="Footer navigation">
                <a href="/">Home</a>
                <a href="/design/">Work</a>
                <a href="/writing/">Writing</a>
                <a href="/playground/">Playground</a>
                <a href="/about/">About</a>
            </nav>
            <nav class="footer-social" aria-label="Social links">
                <div class="email">
                    <a href={`mailto:${email}`}>{email}</a>
                    <button
                        type="button"
                        class="copy-email-btn"
                        aria-label="Copy email address"
                        data-email={email}
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="copy-icon"
                            aria-hidden="true"
                        >
                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                        </svg>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="check-icon"
                            aria-hidden="true"
                        >
                            <path d="M20 6 9 17l-5-5"></path>
                        </svg>
                        <span class="copy-confirmation" aria-hidden="true">Copied!</span>
                    </button>
                    <span class="sr-only" aria-live="polite" id="copy-email-feedback"></span>
                </div>

                <a
                    href="https://github.com/made-by-max"
                    target="_blank"
                    rel="noopener">Github</a
                >
                <a
                    href="https://www.linkedin.com/in/madebymax/"
                    target="_blank"
                    rel="noopener">LinkedIn</a
                >
            </nav>
        </div>
    </div>
    <div class="footer-wordmark" aria-hidden="true">//</div>
</footer>

<script>
    const COPY_RESET_MS = 2000;

    const copyButtons = document.querySelectorAll<HTMLButtonElement>(".copy-email-btn");
    const resetTimers = new WeakMap<HTMLButtonElement, number>();

    copyButtons.forEach((btn) => {
        btn.addEventListener("click", async () => {
            const email = btn.dataset.email;
            const feedback = document.getElementById("copy-email-feedback");
            if (!email) return;

            try {
                await navigator.clipboard.writeText(email);
                btn.setAttribute("data-copied", "");
                btn.setAttribute("aria-label", "Copied!");
                if (feedback) feedback.textContent = "Email copied to clipboard";

                const existingTimer = resetTimers.get(btn);
                if (existingTimer) window.clearTimeout(existingTimer);

                resetTimers.set(
                    btn,
                    window.setTimeout(() => {
                        btn.removeAttribute("data-copied");
                        btn.setAttribute("aria-label", "Copy email address");
                        if (feedback) feedback.textContent = "";
                    }, COPY_RESET_MS),
                );
            } catch {
                btn.setAttribute("aria-label", "Failed to copy email");
                if (feedback) feedback.textContent = "Failed to copy email";
            }
        });
    });
</script>

<style>
    .email {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: var(--size-1);
    }

    .copy-email-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 2px;
        background: none;
        border: none;
        color: inherit;
        cursor: pointer;
        border-radius: 2px;
        transition:
            color 150ms ease,
            opacity 150ms ease,
            transform 150ms ease;
    }

    .copy-email-btn:hover,
    .copy-email-btn:focus-visible {
        color: var(--text-brand-dark);
    }

    .copy-email-btn:focus-visible {
        outline: 2px solid var(--text-brand-dark);
        outline-offset: 2px;
    }

    .copy-email-btn:active {
        opacity: 0.7;
        transform: scale(0.92);
    }

    .check-icon,
    .copy-confirmation {
        display: none;
    }

    .copy-email-btn[data-copied] {
        color: var(--text-brand-dark);
    }

    .copy-email-btn[data-copied] .copy-icon {
        display: none;
    }

    .copy-email-btn[data-copied] .check-icon {
        display: block;
    }

    .copy-email-btn[data-copied] .copy-confirmation {
        display: block;
        position: absolute;
        left: 50%;
        bottom: calc(100% + 6px);
        transform: translateX(-50%);
        padding: 2px 6px;
        font-family: var(--font-sans);
        font-size: var(--text-xs);
        font-weight: var(--font-weight-medium);
        white-space: nowrap;
        color: var(--text-primary-inverted);
        background: var(--background-secondary-inverted);
        border: 1px solid var(--text-brand-dark);
        border-radius: 4px;
        pointer-events: none;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
</style>
