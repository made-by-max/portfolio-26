---
import BaseButton from "./BaseButton.astro";
const { url } = Astro.props;
---

<BaseButton url={url} variant="github">
    View on Github
    <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <path d="M7 7h10v10"></path><path d="M7 17 17 7"></path>
    </svg>
</BaseButton>
