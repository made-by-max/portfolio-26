---
import ThemeToggleButton from "../components/ThemeToggleButton.astro";
---

<nav>
    <div>
        <a href="/"> Max Taylor</a>
    </div>
    <div class="trailing">
        <div class="pageLinks">
            <a href="/design/">Design</a>
            <a href="/dev/">Dev</a>
            <a href="/writing/">Writing</a>
            <a href="/about/">About</a>
        </div>
        <div class="themeToggle">
            <ThemeToggleButton />
        </div>
    </div>

    <style>
        nav {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            margin-inline: auto;
            margin-block: var(--size-6);
            max-width: var(--max-width);
            margin-inline: auto;
        }

        nav a {
            text-decoration: none;
            color: inherit;
            font-size: var(--font-size-3);
            font-weight: var(--font-weight-5);
        }

        nav a:hover,
        a:focus {
            color: var(--brand-primary);
        }

        .pageLinks {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: var(--size-4);
        }

        .trailing {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: var(--size-4);
        }
    </style>
</nav>
