---
import { getCollection } from "astro:content";
import BlogTag from "./BlogTag.astro";

const writing = await getCollection("writing");

// Assuming your posts are in 'src/content/posts/'
const allTags = [...new Set(writing.map((post) => post.data.tags).flat())];
---

{
    allTags.map((tag) => (
        <p class="post-tags">
            <BlogTag href={`/tags/${tag}`} text={tag} />
        </p>
    ))
}

<style>
    p {
        margin-block: var(--size-1);
    }
</style>
