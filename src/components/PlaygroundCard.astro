---
import type { CollectionEntry } from "astro:content";
const { post } = Astro.props;
import { Image } from "astro:assets";
---

<a href={`/${post.collection}/${post.id}`} class="card-wrap">
    <!-- Orange shadow card at TOP-RIGHT -->
    <!-- <div class="brutalist-shadow card-shadow" aria-hidden="true"></div> -->

    <!-- Main card (bottom-left) -->
    <div class="inner-card">
        <div class="card-image card-image-16-9">
            <Image
                src={post.data.img}
                alt={`Cover image for ${post.data.title}`}
                class="card-img"
            />
        </div>
        <div class="card-content playground-content">
            <h3>{post.data.title}</h3>
        </div>
    </div>
</a>

<style>
    .inner-card {
        box-shadow: 6px 6px 0px 0px var(--brand-primary);
        transition:
            box-shadow 150ms ease,
            transform 150ms ease;

        border-radius: 11px;
        position: relative;
        background-color: var(--card-background, #f3f4f2);
        border: 2px solid var(--card-stroke, #111);
        border-radius: 11px;
        overflow: hidden;
        z-index: 1;
        /*height: 100%;*/
    }

    .inner-card:hover,
    .inner-card:focus {
        box-shadow: 3px 3px 0px 0px var(--brand-primary);
        transform: translate(2px, 2px);
        text-decoration: none;
    }

    /* Orange shadow, slightly thinner border */
    /*.card-shadow {
    background-color: var(--brand-primary, #ff5c00);
    border-width: 2px;
  }*/

    /* PlaygroundCard uses a thinner border on the inner frame */
    /*.card-inner-thin {
    border-width: 1.8px;
  }*/

    /* 16:9 image with thin white border (as in Figma) */
    .card-image-16-9 {
        background-color: var(--card-background, #f3f4f2);
    }

    .card-image-16-9 .card-img {
        border-radius: 6px;
        border: 0.5px solid var(--card-stroke);
    }

    .playground-content {
        padding: 12px 20px 20px;
    }

    h3 {
        font-family: var(--font-accent);
        font-size: var(--text-s);
        font-weight: var(--font-weight-semibold);
        line-height: 1.3;
        color: var(--card-text-primary, #111);
        margin: 0;
        max-inline-size: none;
    }

    a {
        text-decoration: none;
    }

    a:hover,
    a:focus {
        text-decoration: none;
    }
</style>
