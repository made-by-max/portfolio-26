---
import type { CollectionEntry } from "astro:content";
const { post } = Astro.props;
import { Image } from "astro:assets";
---

<a href={`/${post.collection}/${post.id}`} class="playground-card">
  <!-- Orange shadow card at TOP-RIGHT -->
  <div class="card-shadow-bg" aria-hidden="true"></div>

  <!-- Main card (bottom-left) -->
  <div class="card-inner">
    <div class="card-image">
      <Image
        src={post.data.img}
        alt={`Cover image for ${post.data.title}`}
      />
    </div>
    <div class="card-content">
      <h3>{post.data.title}</h3>
    </div>
  </div>
</a>

<style>
  .playground-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    /* Padding at TOP and RIGHT so orange card is visible */
    padding-top: 12px;
    padding-right: 12px;
  }

  /* Orange card at TOP-RIGHT */
  .card-shadow-bg {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 12px;
    left: 12px;
    background-color: var(--brand-primary, #ff5c00);
    border: 1.8px solid var(--card-stroke, #111);
    border-radius: 10px;
    transform: rotate(0.4deg);
    transition: transform 250ms ease;
  }

  .playground-card:hover .card-shadow-bg {
    transform: rotate(2.5deg);
  }

  .card-inner {
    position: relative;
    background-color: var(--card-background, #f3f4f2);
    border: 1.8px solid var(--card-stroke, #111);
    border-radius: 11px;
    overflow: hidden;
    z-index: 1;
  }

  .card-image {
    padding: 16px;
    /* Thin white border around the image as in Figma */
    background-color: var(--card-background, #f3f4f2);
  }

  .card-image img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
    display: block;
    border: 1.5px solid white;
  }

  .card-content {
    padding: 12px 20px 20px;
  }

  h3 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--card-text-primary, #111);
    margin: 0;
    max-inline-size: none;
  }
</style>
