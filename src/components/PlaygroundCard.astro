---
import type { CollectionEntry } from "astro:content";
const { post } = Astro.props;
import { Image } from "astro:assets";
---

<a href={`/${post.collection}/${post.id}`} class="brutalist-card-wrap">
  <!-- Orange shadow card at TOP-RIGHT -->
  <div class="brutalist-shadow card-shadow" aria-hidden="true"></div>

  <!-- Main card (bottom-left) -->
  <div class="brutalist-inner card-inner-thin">
    <div class="card-image card-image-16-9">
      <Image
        src={post.data.img}
        alt={`Cover image for ${post.data.title}`}
        class="card-img"
      />
    </div>
    <div class="card-content playground-content">
      <h3>{post.data.title}</h3>
    </div>
  </div>
</a>

<style>
  /* Orange shadow, slightly thinner border */
  .card-shadow {
    background-color: var(--brand-primary, #ff5c00);
    border-width: 1.8px;
  }

  /* PlaygroundCard uses a thinner border on the inner frame */
  .card-inner-thin {
    border-width: 1.8px;
  }

  /* 16:9 image with thin white border (as in Figma) */
  .card-image-16-9 {
    background-color: var(--card-background, #f3f4f2);
  }

  .card-image-16-9 .card-img {
    aspect-ratio: 16 / 9;
    border-radius: var(--size-px-1);
    border: 1.5px solid white;
  }

  .playground-content {
    padding: 12px 20px 20px;
  }

  h3 {
    font-family: var(--font-sans);
    font-size: var(--text-s);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
    color: var(--card-text-primary, #111);
    margin: 0;
    max-inline-size: none;
  }
</style>
