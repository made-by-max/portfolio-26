---
import { Image } from "astro:assets";

const { src } = Astro.props;
const { alt } = Astro.props;
---
<div class="container">

<Image src={src} alt={alt} />
</div>

<style>
    img {
        max-width: var(--max-text-length);
        margin-block: var(--size-12);
    }
    div {
        max-width: var(--max-text-length);
    }


</style>
