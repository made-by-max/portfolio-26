---
import { Image } from "astro:assets";
const { src, alt } = Astro.props;
---

<div class="brutalist-img-wrap img-wrap-narrow">
  <!-- Orange shadow card at BOTTOM-RIGHT -->
  <div class="brutalist-shadow" aria-hidden="true"></div>
  <div class="brutalist-inner">
    <Image src={src} alt={alt} class="card-img" />
  </div>
</div>

<style>
  .img-wrap-narrow {
    max-width: var(--max-text-length);
  }

  /* Narrow image uses a steeper rotation and slightly smaller radius */
  .brutalist-shadow {
    transform: rotate(1deg);
    border-radius: var(--size-px-2);
  }
</style>
