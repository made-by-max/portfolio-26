---
import { Image } from "astro:assets";
const { src } = Astro.props;
const { alt } = Astro.props;
---
<div class="imgBg">

<Image src={src} alt={alt} />

    </div>


<style>
    img {
        width: var(--max-text-length);
        padding: 0px;
    }


    .imgBg {
        border-radius: 6px;
        background: var(--background-secondary);
        width: var(--max-text-length);
    }
</style>



