---
import { Image } from "astro:assets";
const { post } = Astro.props;
---
<div class="full-bleed">

    <div class="hero wrapper-medium">

        <div class="heroContent">
            <h1 class="post-heading">
                {post.data.title}
            </h1>
            <p class="intro">
                <span>Overview-- </span>{post.data.intro}
            </p>
        </div>




            <Image
                src={post.data.img}
                alt={`Cover image for ${post.data.title}`}
            />


        </div>
    </div>


<style>

.full-bleed {
    background: radial-gradient(125% 125% at 50% 10%, var(--background-primary
    ) 40%, var(--radial-gradient) 100%);

}

    h1 {
        margin-block-end: var(--size-8);
    }

    .intro {
        margin-block-end: var(--size-8);
        font-size: var(--text-xl);
        line-height: var(--text-2xl-line-height);
        max-width: var(--wrapper-medium);
    }

    .heroImage {
        width: 100%;
        margin-block-end: -20px;
    }


.hero
     {
        margin-block-end:-20p;

    }

    span {
        font-weight: bold;
    }

</style>
