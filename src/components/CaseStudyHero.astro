---
import { Image } from "astro:assets";
const { post } = Astro.props;
---

<div class="wrapper-wide">
    <div class="hero">
        <div>
            <h1 class="post-heading">
                {post.data.title}
            </h1>
            <p class="intro">
                {post.data.intro}
            </p>
        </div>
        <div class="container">

        <div class="heroImage">
            <Image
                src={post.data.img}
                alt={`Cover image for ${post.data.title}`}
            />
        </div>
        </div>
    </div>
</div>

<style>
    h1 {
        margin-block-end: var(--size-12-fluid);
    }

    .intro {
        margin-block-end: var(--size-8);
        font-size: var(--text-xl);
        line-height: var(--text-xl-line-height);
        max-width: 48rem;
    }



    .hero {
        margin-block-end: var(--size-11-fluid);
    }

    .container {
                --s: 40px; /* the size on the corner */
                --t: 2px;  /* the thickness of the border */
                --g: 6px; /* the gap between the border and image */

                padding: calc(var(--g) + var(--t));
                outline: var(--t) solid var(--corner); /* the color here */
                outline-offset: -5px;
                -webkit-mask:
                  conic-gradient(at var(--s) var(--s),#0000 75%,#000 0)
                  0 0/calc(100% - var(--s)) calc(100% - var(--s)),
                  linear-gradient(#000 0 0) content-box;



</style>
