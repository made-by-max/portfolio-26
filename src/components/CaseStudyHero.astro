---
import { Image } from "astro:assets";
const { post } = Astro.props;
---

<div class="wrapper-wide">
    <div class="hero">
        <div>
            <h1 class="post-heading">
                {post.data.title}
            </h1>
            <p class="intro">
                {post.data.intro}
            </p>
        </div>

        <div class="heroImage">
            <Image
                src={post.data.img}
                alt={`Cover image for ${post.data.title}`}
            />
        </div>
    </div>
</div>

<style>
    h1 {
        margin-block-end: var(--size-12-fluid);
    }

    .intro {
        margin-block-end: var(--size-8);
        font-size: var(--text-xl);
        line-height: var(--text-xl-line-height);
        max-width: 48rem;
    }

    img {
        border-radius: 8px;
    }

    .hero {
        margin-block-end: var(--size-11-fluid);
    }
</style>
