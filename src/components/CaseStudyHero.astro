---
import { Image } from "astro:assets";
const { post } = Astro.props;
---

<div class="case-study-hero wrapper-medium">
  <div class="hero-content">
    <h1>{post.data.title}</h1>
    <p class="intro">
      <span class="overview-label">Overview— </span>{post.data.intro}
    </p>
  </div>

  <!-- Brutalist image wrapper: yellow rotated card behind image -->
  <div class="hero-image-wrap">
    <div class="image-shadow-bg" aria-hidden="true"></div>
    <div class="image-inner">
      <Image src={post.data.img} alt={`Cover image for ${post.data.title}`} />
    </div>
  </div>
</div>

<style>
  .case-study-hero {
    padding-block-end: var(--size-12);
  }

  h1 {
    margin-block-end: var(--size-8);
  }

  .intro {
    margin-block-end: var(--size-12);
    font-size: var(--text-xl);
    line-height: var(--text-2xl-line-height);
    max-width: 65ch;
    max-inline-size: none;
  }

  .overview-label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: 0.05em;
    color: var(--text-soft, #808080);
  }

  /* Brutalist image wrapper */
  .hero-image-wrap {
    position: relative;
    padding-top: 14px;
    padding-right: 14px;
  }

  .image-shadow-bg {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 14px;
    left: 14px;
    background-color: var(--brand-secondary, #f2c94c);
    border: 2px solid var(--card-stroke, #111);
    border-radius: 10px;
    transform: rotate(0.73deg);
  }

  .image-inner {
    position: relative;
    z-index: 1;
    border: 2px solid var(--card-stroke, #111);
    border-radius: 10px;
    overflow: hidden;
  }

  .image-inner img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }
</style>
