---
import { Image } from "astro:assets";
const { post } = Astro.props;
---

<div class="wrapper-wide">
    <div class="hero">
        <div>
            <h1 class="post-heading">
                {post.data.title}
            </h1>
            <p class="intro">
                {post.data.intro}
            </p>
        </div>

        <div class="heroImage">
            <Image src={post.data.img} alt={post.data.title} />
        </div>
    </div>
</div>

<style>
    .hero {
        margin-block: 180px;
    }

    .post-heading {
        margin-block-end: 16px;
        font-size: 56px;
    }

    .intro {
        margin-block-end: 56px;
        font-size: 20px;
    }

    img {
        border-radius: 8px;
    }
</style>
