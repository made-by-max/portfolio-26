---
import { Image } from "astro:assets";
const { post } = Astro.props;
---

<div class="case-study-hero wrapper-medium">
  <div class="hero-content">

    <h1>{post.data.title}</h1>
<p class="eyebrow">Overview </p>
    <p class="intro">
      {post.data.intro}
    </p>
  </div>

  <!-- Brutalist image wrapper: yellow rotated card behind image -->
  <!-- <div class="brutalist-card-wrap hero-image-wrap">
    <div class="brutalist-shadow hero-image-shadow" aria-hidden="true"></div>
    <div class="brutalist-inner"> -->

    <div class="img-wrap">
      <div class="img-shadow-bg" aria-hidden="true"></div>
      <div class="img-inner">
      <Image src={post.data.img} alt={`Cover image for ${post.data.title}`} class="card-img hero-img" />
    </div>
  </div>
</div>

<style>
  .case-study-hero {
    padding-block-end: var(--size-12);
  }

  h1 {
    margin-block-end: var(--size-8);
  }

  .intro {
    margin-block-end: var(--size-12);
    font-size: var(--text-xl);
    line-height: var(--text-2xl-line-height);
    max-width: 65ch;
    max-inline-size: none;
  }

  .overview-label {
    font-family: var(--font-accent);
    font-weight: var(--font-weight-medium);
    font-size: var(--text-s);
    letter-spacing: var(--font-letterspacing-2);
    color: var(--text-soft, #808080);
  }

  .eyebrow {
    margin-block-end: var(--size-2);
  }

  /* Hero uses a 14px offset instead of the card default 12px */
  /*.hero-image-wrap {
      position: relative;
      /* Space at bottom and right for shadow card */
      /*margin-bottom: 16px;
      margin-right: 16px;
      margin-block: var(--size-10-fluid, 2.5rem);
      max-width: 300px;
  }

  .hero-image-wrap .brutalist-shadow {
    bottom: 14px;
    left: 14px;
  }

  .hero-image-shadow {
    background-color: var(--brand-secondary, #f2c94c);
    transform: rotate(0.73deg);
  }

  .hero-img {
    border-radius: var(--size-1);
  }*/



  .img-wrap {
    position: relative;
    /* Space at bottom and right for shadow card */
    margin-bottom: 16px;
    margin-right: 16px;
    margin-block: var(--size-12-fluid, 2.5rem);
    max-width: 100%;
  }

  /* Orange shadow card at BOTTOM-RIGHT */
  .img-shadow-bg {
    position: absolute;
    top: 16px;
    left: 16px;
    right: -16px;
    bottom: -16px;
    background-color: var(--brand-secondary, #ff5c00);
    border: 2px solid var(--card-stroke, #111);
    border-radius: 10px;
    transform: rotate(0.73deg);
  }

  .img-inner {
      position: relative;
      background-color: var(--background-primary, #f3f4f2);
      border-radius: 11px;
        border: 2px solid var(--card-stroke, #111);
      overflow: hidden;
      z-index: 1;
      height: 100%;
      display: flex;
      flex-direction: column;
  }

  .img-inner img {
    max-width: 100%;
    height: auto;
    display: block;
    margin-block: 0px;
  }
</style>
