---
const { logo, tech } = Astro.props;
import { Image } from "astro:assets";
---

<div class="tech-stack">

    <Image src={logo} alt=`${tech} logo` />
    <p>{tech}</p>

</div>
<style>
.tech-stack {
display: flex;
gap: 12px;
align-items: center;
width: fit-content;
border: 1px solid var(--line);
border-radius: 4px;
padding-inline: var(--size-2);
padding-block: 4px;
background-color: var(--background-secondary);
}
p {
    font-weight: bold;
    font-size: var(--text-s)
}
img {
    max-width: 24px;
}
</style>
