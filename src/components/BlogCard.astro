---
import type { CollectionEntry } from "astro:content";
import BlogTag from "./BlogTag.astro";

const { post } = Astro.props;
const date = post.data.date?.toLocaleDateString("en-US", { month: "2-digit", day: "2-digit", year: "2-digit" }) ?? "";
---

<div class="blog-card">
  <!-- Animated left border via pseudo-element -->
  <span class="date">{date}</span>
  <a class="title" href={`/${post.collection}/${post.id}`}>{post.data.title}</a>
  <div class="tags">
    {post.data.tags?.map((tag: string) => (
      <BlogTag href={`/tags/${tag}`} text={tag} />
    ))}
  </div>
  <a class="arrow" href={`/${post.collection}/${post.id}`} aria-label={`Read ${post.data.title}`}>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
    </svg>
  </a>
</div>

<style>
  .blog-card {
    position: relative;
    display: grid;
    grid-template-columns: 110px 1fr auto auto;
    align-items: center;
    gap: var(--size-px-2);
    padding: 20px var(--size-px-3);
    border-bottom: 1px solid var(--text-soft, #808080);
    transition: color 150ms ease;
  }

  .blog-card:first-of-type,
  .blog-card:first-child {
    border-top: 1px solid var(--text-soft, #808080);
  }

  /* Animated left border — grows from bottom */
  .blog-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background-color: var(--brand-primary, #ff5c00);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 220ms ease;
  }

  .blog-card:hover::before {
    transform: scaleY(1);
  }

  .blog-card:hover .date,
  .blog-card:hover .title,
  .blog-card:hover .arrow {
    color: var(--text-brand-light, #808080);
  }

  .date {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-normal);
    letter-spacing: var(--font-letterspacing-1);
    color: var(--text-soft, #808080);
    white-space: nowrap;
    transition: color 150ms ease;
  }

  .title {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--text-xl-line-height);
    color: var(--text, #111);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-1);
    justify-content: flex-end;
  }

  .arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text, #111);
    text-decoration: none;
    flex-shrink: 0;
    transition: color 150ms ease;
  }

  @media (max-width: 640px) {
    .blog-card {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: var(--size-px-2);
    }

    .date {
      grid-column: 1;
      grid-row: 2;
    }

    .title {
      grid-column: 1;
      grid-row: 1;
      font-size: var(--text-base);
    }

    .tags {
      display: none;
    }

    .arrow {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
