---
import type { CollectionEntry } from "astro:content";

const { post } = Astro.props;
const date = post.data.date?.toLocaleDateString("en-US", { month: "2-digit", day: "2-digit", year: "2-digit" }) ?? "";
---

<div class="blog-card">
  <!-- Animated left border via pseudo-element -->
  <span class="date">{date}</span>
  <a class="title" href={`/${post.collection}/${post.id}`}>{post.data.title}</a>
  <div class="tags">
    {post.data.tags?.map((tag: string) => (
      <a class="tag" href={`/tags/${tag}`}>{tag}</a>
    ))}
  </div>
  <a class="arrow" href={`/${post.collection}/${post.id}`} aria-label={`Read ${post.data.title}`}>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
    </svg>
  </a>
</div>

<style>
  .blog-card {
    position: relative;
    display: grid;
    grid-template-columns: 110px 1fr auto auto;
    align-items: center;
    gap: var(--size-2);
    padding: 20px 16px;
    border-bottom: 1px solid var(--text-soft, #808080);
    transition: color 150ms ease;
  }

  .blog-card:first-of-type,
  .blog-card:first-child {
    border-top: 1px solid var(--text-soft, #808080);
  }

  /* Animated left border — grows from bottom */
  .blog-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background-color: var(--brand-primary, #ff5c00);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 220ms ease;
  }

  .blog-card:hover::before {
    transform: scaleY(1);
  }

  .blog-card:hover .date,
  .blog-card:hover .title,
  .blog-card:hover .arrow {
    color: var(--text-soft, #808080);
  }

  .date {
    font-family: var(--font-accent);
    font-size: var(--text-xs)
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--text-soft, #808080);
    white-space: nowrap;
    transition: color 150ms ease;
  }

  .title {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: var(--text-xl-line-height);
    color: var(--text, #111);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-1);
    justify-content: flex-end;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    background-color: var(--tag-background, #fff);
    border: 1px solid var(--tag-stroke, #1a1a1a);
    border-radius: 99px;
    box-shadow: 1.5px 1.5px 0px 0px var(--tag-shadow, #f2c94c);
    color: var(--tag-text, #111);
    font-family: var(--font-accent);
    font-size: var(--text-xxs);
    font-weight: 500;
    letter-spacing: 0.25em;
    padding: 4px 12px;
    text-decoration: none;
    text-transform: uppercase;
    transition: box-shadow 120ms ease, transform 120ms ease;
    white-space: nowrap;
  }

  .tag:hover,
  .tag:focus {
    box-shadow: none;
    transform: translate(1.5px, 1.5px);
    text-decoration: none;
  }

  .arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text, #111);
    text-decoration: none;
    flex-shrink: 0;
    transition: color 150ms ease;
  }

  @media (max-width: 640px) {
    .blog-card {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: 8px;
    }

    .date {
      grid-column: 1;
      grid-row: 2;
    }

    .title {
      grid-column: 1;
      grid-row: 1;
      font-size: 1.125rem;
    }

    .tags {
      display: none;
    }

    .arrow {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
