---
import { ArrowRight } from "@lucide/astro";
const { text, url } = Astro.props;
---

<a href={url} class="link-to-more">
  {text}<ArrowRight />
</a>

<style>
  .link-to-more {
    display: inline-flex;
    align-items: center;
    gap: var(--size-1);
    color: var(--text-brand);
    font-family: var(--font-sans);
    font-size: var(--text-s);
    font-weight: var(--font-weight-medium);
    line-height: 24px;
    text-decoration: none;
  }

  .link-to-more:hover,
  .link-to-more:focus {
    color: var(--text-brand);
    text-decoration: none;
     opacity: 0.7;
  }
</style>
