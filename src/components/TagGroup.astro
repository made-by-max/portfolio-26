---
import type { CollectionEntry } from "astro:content";
import BlogTag from "./BlogTag.astro";

const { post } = Astro.props;
---

<div class="tag-group">
  {
    post.data.tags.map((tag: string) => (
      <BlogTag href={`/tags/${tag}`} text={tag} />
    ))
  }
</div>

<style>
  .tag-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--size-px-2);
  }
</style>
