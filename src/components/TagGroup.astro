---
import type { CollectionEntry } from "astro:content";

const { post } = Astro.props;
---

<div class="tag-group">
  {
    post.data.tags.map((tag: string) => (
      <a class="tag" href={`/tags/${tag}`}>
        {tag}
      </a>
    ))
  }
</div>

<style>
  .tag-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    background-color: var(--tag-background, #fff);
    border: 1px solid var(--tag-stroke, #1a1a1a);
    border-radius: 99px;
    box-shadow: 1.5px 1.5px 0px 0px var(--tag-shadow, #f2c94c);
    color: var(--tag-text, #111);
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    text-decoration: none;
    text-transform: uppercase;
    transition: box-shadow 120ms ease, transform 120ms ease;
    white-space: nowrap;
  }

  .tag:hover,
  .tag:focus {
    box-shadow: none;
    transform: translate(1.5px, 1.5px);
    text-decoration: none;
  }
</style>
