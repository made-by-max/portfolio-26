---
import { Image } from "astro:assets";
const { src } = Astro.props;
const { alt } = Astro.props;
---
<div class="container">
    <div class="inner-container">
<Image src={src} alt={alt} />

    </div>
</div>

<style>
    img {
        width: var(--wrapper-medium);

    }
    /*div {
        max-width: var(--max-text-length);
    }*/

    .inner-container {
        border: 1px solid var(--line);

    }
    .container {
                   --s: 30px; /* the size on the corner */
                --t: 3px;  /* the thickness of the border */
                --g: 4px; /* the gap between the border and image */

                padding: calc(var(--g) + var(--t));
                outline: var(--t)solid var(--corner); /* the color here */
                outline-offset: -5px;
                -webkit-mask:
                  conic-gradient(at var(--s) var(--s),#0000 75%,#000 0)
                  0 0/calc(100% - var(--s)) calc(100% - var(--s)),
                  linear-gradient(#000 0 0) content-box;

                  margin-block: var(--size-10-fluid);


    }
</style>
