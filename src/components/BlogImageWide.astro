---
import { Image } from "astro:assets";
const { src, alt } = Astro.props;
---

<div class="img-wrap">
  <div class="img-shadow-bg" aria-hidden="true"></div>
  <div class="img-inner">
    <Image src={src} alt={alt} />
  </div>
</div>

<style>
  .img-wrap {
    position: relative;
    /* Space at bottom and right for shadow card */
    margin-bottom: 16px;
    margin-right: 16px;
    margin-block: var(--size-10-fluid, 2.5rem);
    max-width: var(--wrapper-medium);
  }

  /* Orange shadow card at BOTTOM-RIGHT */
  .img-shadow-bg {
    position: absolute;
    top: 16px;
    left: 16px;
    right: -16px;
    bottom: -16px;
    background-color: var(--brand-primary, #ff5c00);
    border: 2px solid var(--card-stroke, #111);
    border-radius: 10px;
    transform: rotate(0.73deg);
  }

  .img-inner {
      position: relative;
      background-color: var(--background-secondary, #f3f4f2);
      border: 2.5px solid var(--card-stroke, #111);
      border-radius: 11px;
      overflow: hidden;
      z-index: 1;
      /* Stretch to fill, with text content expanding */
      height: 100%;
      display: flex;
      flex-direction: column;
  }

  .img-inner img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
