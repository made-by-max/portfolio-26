---
import { Image } from "astro:assets";
const { src } = Astro.props;
const { alt } = Astro.props;
---
<div class="imgBg">

<Image src={src} alt={alt} />

    </div>


    <style>
        Image {

            padding: 0px;
        }


        .imgBg {
            border-radius: 8px;
            background: var(--background-secondary);
            max-width: var(--wrapper-medium);
        }
    </style>
