---
import { Image } from "astro:assets";
const { src, alt } = Astro.props;
---

<div class="brutalist-img-wrap img-wrap-wide">
  <!-- Orange shadow card at BOTTOM-RIGHT -->
  <div class="brutalist-shadow" aria-hidden="true"></div>
  <div class="brutalist-inner">
    <Image src={src} alt={alt} class="card-img" />
  </div>
</div>

<style>
  .img-wrap-wide {
    max-width: var(--wrapper-medium);
  }

  /* Wide image uses a slightly flatter rotation */
  .brutalist-shadow {
    transform: rotate(0.73deg);
  }
</style>
