---
import { Image } from "astro:assets";
const { src, alt } = Astro.props;
---

<Image src={src} alt={alt} class="card-img" data-lightbox />

<style>
    img {
        border-radius: 11px;
        border: 2px solid var(--card-stroke, #111);
        box-shadow: 4px 4px 0px 0px var(--card-stroke);
        margin-block: var(--size-12-fluid);
        background-color: var(--background-primary, #f3f4f2);
    }
</style>
