---
import type { CollectionEntry } from "astro:content";

const { post } = Astro.props;
import { Image } from "astro:assets";
---

<a href={`/${post.collection}/${post.id}`} class="card-wrap">
  <!-- Yellow shadow card at TOP-RIGHT (behind main card) -->
  <!-- <div class="brutalist-shadow card-shadow" aria-hidden="true"></div> -->

  <!-- Main card (bottom-left) -->
  <div class="inner-card">
    <div class="card-image card-image-16-10">
      <Image
        src={post.data.img}
        alt={`Cover image for ${post.data.title}`}
        class="card-img"
      />
    </div>
    <div class="card-content case-study-content">
      <h3>{post.data.title}</h3>
      <p>{post.data.description}</p>
    </div>
  </div>
</a>

<style>

.inner-card {
    box-shadow: 6px 6px 0px  0px var(--brand-secondary);
     transition: box-shadow 150ms ease, transform 150ms ease;

      border-radius: 11px;
      position: relative;
      background-color: var(--card-background, #f3f4f2);
      border: 2px solid var(--card-stroke, #111);
      border-radius: 11px;
      overflow: hidden;
      z-index: 1;
      height: 100%;
}

.inner-card:hover,
.inner-card:focus {
  box-shadow: 3px 3px 0px 0px var(--brand-secondary);
  transform: translate(2px, 2px);
  text-decoration: none;
}


  /* Yellow shadow, slightly thicker border */
  /*.card-shadow {
    background-color: var(--brand-secondary, #f2c94c);
    border-width: 2.5px;
  }*/

  /* Crop image top/bottom; remove bottom padding so image butts against content */
  .card-image-16-10 {
    padding-bottom: 0;
  }

  .card-image-16-10 .card-img {
    aspect-ratio: 16 / 10;
    border-radius: var(--size-px-1);
    border: .5px solid var(--card-stroke);
  }

  .case-study-content {
    padding: 20px var(--size-px-5) var(--size-px-5);
    gap: 10px;
  }

  h3 {
    font-family: var(--font-accent);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    color: var(--card-text-primary, #111);
    margin: 0;
    max-inline-size: none;
  }

  p {
    font-size: var(--text-s);
    line-height: 1.6;
    color: var(--card-text-soft, #444);
    margin: 0;
    max-inline-size: none;
  }

  a {
      text-decoration: none;
  }

  a:hover, a:focus {
      text-decoration: none;
  }
</style>
