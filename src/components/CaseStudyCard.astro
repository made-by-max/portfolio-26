---
import type { CollectionEntry } from "astro:content";

const { post } = Astro.props;
import { Image } from "astro:assets";
---

<a href={`/${post.collection}/${post.id}`} class="brutalist-card-wrap">
  <!-- Yellow shadow card at TOP-RIGHT (behind main card) -->
  <div class="brutalist-shadow card-shadow" aria-hidden="true"></div>

  <!-- Main card (bottom-left) -->
  <div class="brutalist-inner">
    <div class="card-image card-image-16-10">
      <Image
        src={post.data.img}
        alt={`Cover image for ${post.data.title}`}
        class="card-img"
      />
    </div>
    <div class="card-content case-study-content">
      <h3>{post.data.title}</h3>
      <p>{post.data.description}</p>
    </div>
  </div>
</a>

<style>
  /* Yellow shadow, slightly thicker border */
  .card-shadow {
    background-color: var(--brand-secondary, #f2c94c);
    border-width: 2.5px;
  }

  /* Crop image top/bottom; remove bottom padding so image butts against content */
  .card-image-16-10 {
    padding-bottom: 0;
  }

  .card-image-16-10 .card-img {
    aspect-ratio: 16 / 10;
  }

  .case-study-content {
    padding: 20px var(--size-px-5) var(--size-px-5);
    gap: 10px;
  }

  h3 {
    font-family: var(--font-accent);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    color: var(--card-text-primary, #111);
    margin: 0;
    max-inline-size: none;
  }

  p {
    font-size: var(--text-s);
    line-height: 1.6;
    color: var(--card-text-soft, #444);
    margin: 0;
    max-inline-size: none;
  }
</style>
