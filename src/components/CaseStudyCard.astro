---
import type { CollectionEntry } from "astro:content";

const { post } = Astro.props;
import { CldImage } from "astro-cloudinary";
---

<div class="case-study-card">
    <div class="img-container">
        <div class="img">
            <CldImage
                src={post.data.img}
                alt={`Cover image for ${post.data.title}`}
            />
        </div>
    </div>

    <div class="content">
        <a class="card-primary-action" href=`/${post.collection}/${post.id}`
            ><h2 class="text-lg">{post.data.title}</h2></a
        >
        {post.data.description}
    </div>
</div>

<style>
    .case-study-card {
        grid-row: span 3;
        display: grid;
        grid-template-rows: subgrid;
        gap: var(--size-5);
        position: relative;
        background-color: var(--background-secondary);
        /*background:
            linear-gradient(rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.3)),
            linear-gradient(rgb(180, 220, 255) 0%, rgb(207, 162, 251) 100%);*/
        border-radius: 8px;
        /*border: 1px solid transparent;*/
    }

    img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
    }

    .img-container {
        margin-top: 24px;
        padding-inline: 16px;
    }

    .content {
        grid-row: span 2;
        display: grid;
        grid-template-rows: subgrid;
        padding: 24px;
        gap: 4px;
    }

    p {
        /*margin-block-end: var(--size-2);*/
    }

    h2 {
        font-size: var(--text-base);
        line-height: 1.4;
        margin-block-end: var(--size-1);
    }

    a {
        font-size: var(--text-base);
        font-weight: var(--font-weight-medium);
        color: inherit;
        text-decoration: none;
    }

    /*.case-study-card:hover {
        border: 1px solid var(--blue-200);
    }*/

    .card-primary-action::before {
        content: ""; /* 1 */
        position: absolute; /* 2 */
        inset: 0; /* 2 */
        z-index: 1; /* 3 */
        cursor: pointer; /* 1 */
    }

    .card-primary-action:focus {
        outline: 1px solid;
    }
</style>
