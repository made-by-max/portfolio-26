---
import type { CollectionEntry } from "astro:content";

const { post } = Astro.props;
import LinkToMore from "../components/LinkToMore.astro";
import { Image } from "astro:assets";
---

<div class="case-study-card">
    <div class="imgBg">
            <a href={`/${post.collection}/${post.id}`}><Image
                src={post.data.img}
                alt={`Cover image for ${post.data.title}`}
            /></a>
    </div>

    <div class="content">

      <h3>{post.data.title}</h3>
        <p>{post.data.description}</p>
        <LinkToMore text="Case study" url={`/${post.collection}/${post.id}`} />
    </div>

</div>

<style>
    .case-study-card {
        grid-row: span 5;
        display: grid;
        grid-template-rows: subgrid;
        gap: var(--size-3);

        /*background-color: var(--background-secondary);
   border-radius: 8px;*/
    }

    img {
        max-width: 90%;
        margin-inline: auto;
        margin-block-start: var(--size-3);
        height: auto;
        /*border-radius: 8px 8px 0 0;*/
    }

    .imgBg {
        border-radius: 8px;
        /*background: radial-gradient(125% 125% at 50% 30%, var(--background-secondary
        ) 40%,
       var(--radial-gradient)  100%);*/
        background: var(--background-secondary);

    }

    .content {
        grid-row: span 4;
        display: grid;
        grid-template-rows: subgrid;
        /*padding-inline: var(--size-3);*/
        padding-block-end: var(--size-5);
        gap: 16px;
    }


        h3 {

     margin-block-end: var(--size-1);
        }

     /*a {
         color: var(--brand-primary);
                text-decoration: none;


            a:hover,
            a:focus {
                text-decoration: none;
            }

    }
        }*/


    /*.case-study-card:hover {
        border: 1px solid var(--blue-200);
    }*/


</style>
