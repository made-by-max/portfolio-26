---
import type { CollectionEntry } from "astro:content";

const { post } = Astro.props;
import { Image } from "astro:assets";
---

<a href={`/${post.collection}/${post.id}`} class="case-study-card">
  <!-- Yellow shadow card at TOP-RIGHT (behind main card) -->
  <div class="card-shadow-bg" aria-hidden="true"></div>

  <!-- Main card (bottom-left) -->
  <div class="card-inner">
    <div class="card-image">
      <Image
        src={post.data.img}
        alt={`Cover image for ${post.data.title}`}
      />
    </div>
    <div class="card-content">
      <h3>{post.data.title}</h3>
      <p>{post.data.description}</p>
    </div>
  </div>
</a>

<style>
  .case-study-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    /* Padding at TOP and RIGHT so yellow card is visible there */
    padding-top: 12px;
    padding-right: 12px;
    /* Fill the full grid cell height */
    height: 100%;
  }

  /* Yellow card positioned at TOP-RIGHT */
  .card-shadow-bg {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 12px;
    left: 12px;
    background-color: var(--brand-secondary, #f2c94c);
    border: 2.5px solid var(--card-stroke, #111);
    border-radius: 10px;
    transform: rotate(0.4deg);
    transition: transform 250ms ease;
  }

  /* Hover: bg card rotates, main card stays still */
  .case-study-card:hover .card-shadow-bg {
    transform: rotate(2.5deg);
  }

  .card-inner {
    position: relative;
    background-color: var(--card-background, #f3f4f2);
    border: 2.5px solid var(--card-stroke, #111);
    border-radius: 11px;
    overflow: hidden;
    z-index: 1;
    /* Stretch to fill, with text content expanding */
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .card-image {
    padding: 16px 16px 0;
    flex-shrink: 0;
  }

  .card-image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .card-content {
    padding: 20px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  h3 {
    font-family: var(--font-accent);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--card-text-primary, #111);
    margin: 0;
    max-inline-size: none;
  }

  p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--card-text-soft, #444);
    margin: 0;
    max-inline-size: none;
  }
</style>
