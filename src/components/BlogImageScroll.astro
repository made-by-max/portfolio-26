---
import { Image } from "astro:assets";
const { src } = Astro.props;
const { alt } = Astro.props;
---

<div tabindex="0" class="image-scroll-container">
    <div class="box">
        <Image src={src} alt={alt} data-no-lightbox />
    </div>
</div>

<style>
    .image-scroll-container {
        overflow: auto;
        margin-block: var(--size-12);
    }
    .box {
        width: 5000px;
        /*height: 100%;*/
    }
    img {
        height: 600px;
        width: 100%;
    }
</style>
