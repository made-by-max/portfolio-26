---
import { ExternalLink } from '@lucide/astro';
const { url } = Astro.props
---

<a href={url} target="_blank"><div class="button">View live site <ExternalLink /></div>

<style>
.button {

  background-color: var(--indigo-8);
  border: var(--indigo-9);
  border-radius: 8px;
  color: #FFFFFF;
  cursor: pointer;
  display: flex;
  gap: var(--size-2);
  align-items: center;
  font-size: var(--text-base);
  font-weight: var( --font-weight-medium);
  margin: 0;
  min-height: 44px;
  padding-inline: var(--size-2);
  padding-block: 0px;
  text-align: center;
  text-decoration: none;
  transition: all 300ms cubic-bezier(.23, 1, 0.32, 1);
  user-select: none;
  -webkit-user-select: none;
  touch-action: manipulation;
  width: fit-content;
  will-change: transform;
}

.button:disabled {
  pointer-events: none;
}

a {
    text-decoration: none;
}
.button:hover, :focus {
  background-color: var(--indigo-10);
}

.button img {
    max-width: 24px;
}
.button:active {
    scale: 0.98;
}
</style>
